{
  "name": "safari-shule",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-iap": "^16.6.1",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.1",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "release:check": "npm run typecheck && npm test && npx expo-doctor",
    "build:preview": "npx eas-cli@latest build --platform all --profile preview",
    "build:production": "npx eas-cli@latest build --platform all --profile production",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production",
    "submit:android": "npx eas-cli@latest submit --platform android --profile production"
  },
  "private": true
}
